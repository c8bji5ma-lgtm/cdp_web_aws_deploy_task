<p id="notice"><%= notice %></p>

<p>
  <strong>Title:</strong>
  <%= @blog.title %>
</p>

<p>
  <strong>Content:</strong>
  <%= @blog.content %>
</p>

<p>
  <strong>Thumbnail:</strong>
  <%= image_tag @blog.thumbnail,
              style: "max-width: 800px; max-height: 800px;" if @blog.thumbnail.attached? %>
</p>

<%= link_to 'Edit', edit_blog_path(@blog) %> |
<%= link_to 'Back', blogs_path %>
